COMPOSE_PROJECT_NAME=daiktuva

# Public site URL. For local testing use http://localhost:8088.
WORDPRESS_URL=https://daiktuva.lt
WORDPRESS_TITLE=Daiktuva
WORDPRESS_ADMIN_USER=adminas
WORDPRESS_ADMIN_PASSWORD=change-this-long-password
WORDPRESS_ADMIN_EMAIL=admin@daiktuva.lt
DEMO_SELLER_PASSWORD=change-this-seller-password

MYSQL_DATABASE=daiktuva_wp
MYSQL_USER=daiktuva_wp
MYSQL_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Local-only WordPress port. Keep this closed on the router/firewall.
WORDPRESS_PORT=8088

# Mailcow / SMTP. Keep the password only in the real .env file.
DAIKTUVA_SMTP_HOST=mail.daiktuva.lt
DAIKTUVA_SMTP_PORT=587
DAIKTUVA_SMTP_SECURE=tls
DAIKTUVA_SMTP_USER=info@daiktuva.lt
DAIKTUVA_SMTP_PASSWORD=
DAIKTUVA_SMTP_FROM_EMAIL=info@daiktuva.lt
DAIKTUVA_SMTP_FROM_NAME=Daiktuva

# Atsakymo kopijai i Sent aplanka per IMAP. Tuscias IMAP host = funkcija isjungta.
DAIKTUVA_IMAP_HOST=
DAIKTUVA_SENT_FOLDER=Sent
# Nuoroda i pasto dezute admino patvirtinimo puslapyje. Tuscia = nuoroda nerodoma.
DAIKTUVA_MAILBOX_URL=

# Optional: use Cloudflare Tunnel instead of exposing 80/443.
# Create a tunnel in Cloudflare Zero Trust and paste the token here.
CLOUDFLARE_TUNNEL_TOKEN=
